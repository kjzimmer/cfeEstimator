{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "npm install --include=dev --prefix server",
        "npm install --include=dev --prefix client"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["npm run build --prefix client"]
    }
  },
  "deploy": {
    "inputs": [{ "step": "build" }],
    "startCommand": "npm start --prefix server"
  }
}
